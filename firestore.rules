rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(nestId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/nests/$(nestId)).data.pigeons;
    }
    function isTaskMember(taskId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tasks/$(taskId))
        && isMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.nest_id);
    }

    // A profile is private to its owner
    match /pigeons/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Joining requires looking a nest up by invite code before you are a member, so signed-in users may
    // read single nests. Only members (or someone adding themselves to a not-yet-full nest) may change one.
    match /nests/{nestId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 1;
      allow create: if signedIn()
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.pigeons == [request.auth.uid];
      allow update: if signedIn() && (
        request.auth.uid in resource.data.pigeons
        || (resource.data.pigeons.size() < 2
            && request.resource.data.pigeons.hasAll(resource.data.pigeons)
            && request.resource.data.pigeons.size() == resource.data.pigeons.size() + 1
            && request.auth.uid in request.resource.data.pigeons));
    }

    match /tasks/{taskId} {
      allow read: if isMember(resource.data.nest_id);
      allow create: if isMember(request.resource.data.nest_id) && request.resource.data.created_by == request.auth.uid;
      allow update, delete: if isMember(resource.data.nest_id);
    }

    // Check-ins: you write your own; nest members can read each other's (shared goals need both)
    match /task_completions/{id} {
      allow read: if isTaskMember(resource.data.task_id);
      allow create: if isTaskMember(request.resource.data.task_id)
        && request.resource.data.pigeon_id == request.auth.uid;
      allow update: if isTaskMember(resource.data.task_id)
        && resource.data.pigeon_id == request.auth.uid
        && request.resource.data.pigeon_id == request.auth.uid
        && request.resource.data.task_id == resource.data.task_id;
    }

    match /claimed_deservings/{id} {
      allow read: if signedIn() && resource.data.pigeon_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.pigeon_id == request.auth.uid;
    }
  }
}
